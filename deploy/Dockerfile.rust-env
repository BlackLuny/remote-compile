# Reference build environment (§8.2).
#
# What a usable rc environment image must provide:
#   * the toolchain and any system libraries the project's build scripts need;
#   * writable /rc/cargo, /rc/target and /rc/rustup mount points, because the
#     container root filesystem is read-only (§7.1).
#
# Build and push it, then approve the resulting digest in the console:
#   docker build -f deploy/Dockerfile.rust-env -t rc-registry:5000/env/rust:1 .
#   docker push rc-registry:5000/env/rust:1

FROM docker.io/library/rust:1-bookworm

# Common build-script dependencies. Adding one here is far cheaper than every
# agent discovering it through a failed build.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        protobuf-compiler \
        cmake \
        libclang-dev \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# No sccache client here: the shared compilation cache is off (see the README's
# Status section) and building it from source cost several minutes of every
# image build for a binary nothing invoked. An image for RC_ENABLE_SCCACHE=1
# has to add it back.

# Mount points supplied by the worker; the rest of the filesystem is read-only.
#
# World-writable because the build does not run as root: rc-worker runs it as
# rc-worker's own uid so that what a build leaves in the shared workspace can
# still be cleaned up before the next task (§7.3). That uid is not known when
# this image is built, and named volumes inherit these modes.
RUN mkdir -p /rc/cargo /rc/target /rc/home /work && chmod 0777 /rc/cargo /rc/target /rc/home /work

# rustup lives on a mount too. A project's rust-toolchain.toml pins a version
# that need not be the one baked in here, and installing it into the image's
# own /usr/local/rustup fails on the read-only root. Moving the store to /rc
# lets the worker back it with a volume: docker seeds a fresh named volume from
# whatever the image has at that path, so the toolchain below is already there
# and only genuinely new pins get downloaded — once per worker, not per task.
RUN mv /usr/local/rustup /rc/rustup && chmod -R a+rwX /rc/rustup
ENV CARGO_HOME=/rc/cargo \
    CARGO_TARGET_DIR=/rc/target \
    RUSTUP_HOME=/rc/rustup \
    HOME=/rc/home

WORKDIR /work
